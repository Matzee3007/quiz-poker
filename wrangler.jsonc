{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quiz-poker",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-02",
  "upload_source_maps": true,
  "durable_objects": {
    "bindings": [{ "name": "SPIELRAUM", "class_name": "Spielraum" }],
  },
  // Im kostenlosen Tarif gibt es nur Durable Objects mit SQLite-Speicher.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Spielraum"] }],
  "assets": {
    // Unbekannte Pfade liefern index.html, die Oberfläche kümmert sich um sie.
    "not_found_handling": "single-page-application",
    // Nur Anfragen an /api/* erreichen den Worker, alles andere sind statische Dateien.
    "run_worker_first": ["/api/*"],
  },
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quiz-poker",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-02",
  // Better Auth hasht unter Cloudflare mit node:crypto.
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "durable_objects": {
    "bindings": [
      { "name": "SPIELRAUM", "class_name": "Spielraum" },
      { "name": "RAUMZAEHLER", "class_name": "Raumzaehler" },
      { "name": "PASSWORTRECHNER", "class_name": "Passwortrechner" },
    ],
  },
  // Im kostenlosen Tarif gibt es nur Durable Objects mit SQLite-Speicher.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Spielraum"] },
    { "tag": "v2", "new_sqlite_classes": ["Raumzaehler"] },
    { "tag": "v3", "new_sqlite_classes": ["Passwortrechner"] },
  ],
  // Täglich alte IP-Adressen und abgelaufene Links löschen.
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quiz-poker",
      "database_id": "7ab68b2f-c445-42e4-899d-e9d4a7fa5901",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    // Schützt das Tageslimit des kostenlosen Tarifs vor Skripten, siehe Projektvision.
    "RAEUME_PRO_STUNDE": "30",
    // Lokal überschreibt .dev.vars diese Adresse. BETTER_AUTH_SECRET ist ein Geheimnis und steht deshalb nicht hier.
    "BETTER_AUTH_URL": "https://quiz-poker.quiz-poker.workers.dev",
  },
  "assets": {
    // Unbekannte Pfade liefern index.html, die Oberfläche kümmert sich um sie.
    "not_found_handling": "single-page-application",
    // Nur Anfragen an /api/* erreichen den Worker, alles andere sind statische Dateien.
    "run_worker_first": ["/api/*"],
  },
}
